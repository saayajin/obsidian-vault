{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "_Files/Templates",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "regex",
  "auto_jump_to_cursor": true,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "folder_templates": [],
  "file_templates": [
    {
      "regex": ".*\\.md$",
      "template": "_Files/Templates/new-note.md"
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": true,
  "enabled_templates_hotkeys": [],
  "startup_templates": [
    "_Files/Scripts/FastStart-StartupScript.md"
  ],
  "intellisense_render": "1",
  "ignore_folders_on_creation": [
    {
      "folder": "_Files"
    },
    {
      "folder": "Archive"
    },
    {
      "folder": "Saved"
    }
  ],
  "enable_ribbon_icon": true
}